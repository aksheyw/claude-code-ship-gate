{
  "_comment": "Example ship-gate config showing every section. Replace the gate commands and scoping globs with the right values for your project.",
  "mainBranch": "main",
  "gates": {
    "tests": {
      "enabled": true,
      "command": [
        {
          "command": "npx vitest run"
        },
        {
          "command": "cd functions && npx vitest run"
        },
        {
          "command": "npm run test:rules",
          "when": [
            "*.rules"
          ]
        }
      ]
    },
    "lint": {
      "enabled": true,
      "command": "npm run lint"
    },
    "typecheck": {
      "enabled": false,
      "command": null
    },
    "build": {
      "enabled": true,
      "command": "npm run build"
    },
    "secretScan": {
      "enabled": true
    },
    "codeReview": {
      "enabled": true,
      "skill": "ship-review",
      "upgrade": null
    },
    "security": {
      "enabled": true,
      "skill": "ship-security",
      "upgrade": null
    },
    "uat": {
      "enabled": true,
      "skill": "verify",
      "mode": "confidence"
    }
  },
  "heavyGates": {
    "audit": {
      "skill": "deep-review",
      "upgrade": "audit",
      "suggestWhen": {
        "filesChanged": 15,
        "areasChanged": 3,
        "riskyPaths": true
      }
    },
    "deep": {
      "skill": "deep-review",
      "upgrade": "deep-review",
      "suggestWhen": {
        "diffLines": 400,
        "riskyPaths": true,
        "release": true
      }
    }
  },
  "regression": {
    "enabled": false,
    "skill": "ai-regression-testing",
    "runWhen": "test-affecting"
  },
  "scoping": {
    "docs": [
      "**/*.md",
      "docs/**"
    ],
    "ui": [
      "src/components/**",
      "src/pages/**",
      "**/*.{tsx,jsx,vue,svelte}"
    ],
    "security": [
      "**/auth/**",
      "**/*payment*",
      "**/*.rules",
      "**/migrations/**",
      "**/.env*",
      "api/**",
      "functions/**",
      "package.json",
      "requirements*.txt",
      "go.mod",
      "Cargo.toml",
      "pubspec.yaml"
    ]
  },
  "deploy": {
    "autoDetect": true,
    "warnOnPush": true
  },
  "hotfix": {
    "skipGates": [
      "uat",
      "regression",
      "audit",
      "deep"
    ]
  },
  "markerTtlSeconds": 900
}
